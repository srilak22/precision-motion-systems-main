# =============================================================================
# INDUS Industrial Robotics — Environment Variable Configuration
# =============================================================================
# IMPORTANT:
# - All credentials below are SERVER-SIDE ONLY.
# - DO NOT prefix private credentials with VITE_ (this would bundle them into client JavaScript).
# - NEVER commit your actual .env or .env.local file to GitHub.
# - Configure these variables in your Vercel Project Settings -> Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Atlassian Jira Cloud Integration (Server-side lead intake & ticket creation)
# -----------------------------------------------------------------------------
# Your Jira API Token generated from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Atlassian account email address associated with the API token
JIRA_EMAIL=your_email@yourdomain.com

# Your Atlassian Cloud domain (e.g. yourcompany.atlassian.net)
JIRA_DOMAIN=yourcompany.atlassian.net

# Target Jira Project Key (e.g. DI, PROJ, LEAD)
JIRA_PROJECT_KEY=DI

# Optional: Atlassian account ID of the default assignee for automated leads
JIRA_ASSIGNEE_ID=your_atlassian_account_id_here

# -----------------------------------------------------------------------------
# 2. Google Apps Script & Google Sheets Telemetry (Server-side telemetry pipeline)
# -----------------------------------------------------------------------------
# Google Apps Script Web App Deployment URL
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# Target Google Spreadsheet ID (from spreadsheet URL)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet GID number (e.g. 0 or 2025481644)
GOOGLE_SPREADSHEET_GID=your_sheet_gid_here

# Full link to the Google Sheet (used for authenticated internal dashboard access)
GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id_here/edit

# -----------------------------------------------------------------------------
# 3. Airtable CRM Integration (Server-side lead & event backup)
# -----------------------------------------------------------------------------
# Airtable Personal Access Token (PAT) with data.records:write scope
AIRTABLE_TOKEN=your_airtable_pat_token_here

# Airtable Base ID (starts with app...)
AIRTABLE_BASE_ID=appYourBaseIdHere

# Default fallback Airtable Table ID (starts with tbl...)
AIRTABLE_TABLE_ID=tblYourTableIdHere

# -----------------------------------------------------------------------------
# 4. Authentication & Dashboard Security (Private Command Center access)
# -----------------------------------------------------------------------------
# A strong, randomly generated 32+ character secret string for signing session cookies
AUTH_SECRET=generate_a_random_32_character_string_here

# Administrator email authorized to access the Website Intelligence Command Center
ADMIN_EMAIL=admin@yourdomain.com

# Administrator password for basic admin authentication
ADMIN_PASSWORD=your_strong_admin_password_here

# Optional: Google OAuth 2.0 Client ID for Google Workspace SSO
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional: Google OAuth 2.0 Client Secret for Google Workspace SSO
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -----------------------------------------------------------------------------
# 5. Client-Side Analytics (Public, browser-exposed telemetry)
# -----------------------------------------------------------------------------
# Microsoft Clarity project ID (Public tracking script tag identifier)
VITE_CLARITY_PROJECT_ID=ysb67jrgfu
