{
  "crons": [
    {
      "path": "/api/youtube-sync?cron=1",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/linkedin-sync?cron=1",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/reports?type=daily",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/reports?type=weekly",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/cron/reports?type=monthly",
      "schedule": "30 3 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/linkedin/callback",
      "destination": "/api/linkedin-sync"
    },
    {
      "source": "/api/auth/linkedin/start",
      "destination": "/api/linkedin-sync?auth=start"
    },
    {
      "source": "/api/report-daily",
      "destination": "/api/cron/reports?type=daily"
    },
    {
      "source": "/api/report-weekly",
      "destination": "/api/cron/reports?type=weekly"
    },
    {
      "source": "/api/report-monthly",
      "destination": "/api/cron/reports?type=monthly"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/email"
    }
  ]
}
